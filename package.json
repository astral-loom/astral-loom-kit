{
  "name": "astral-loom-kit",
  "version": "0.1.0",
  "description": "A unified integration toolkit for Stellar dApp developers.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astral-loom/astral-loom-kit.git"
  },
  "keywords": [
    "stellar",
    "sdk",
    "dapp",
    "crypto",
    "blockchain",
    "wallet",
    "typescript"
  ],
  "author": "Temmy2026",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@albedo-link/intent": "^0.13.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^16.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
